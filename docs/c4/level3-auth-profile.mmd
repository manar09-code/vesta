%% C4 level 3: Auth and Profile components of the Flutter app (VST-27)
%% Rule: Screen -> Controller -> Repository -> Firebase. A screen never talks to Firebase directly.
flowchart TB
  subgraph APP["Vesta Flutter app: Auth and Profile modules"]
    direction TB
    Login["<b>LoginScreen</b><br/>[Component: Flutter screen]<br/>Email and password form"]
    SignUp["<b>SignUpScreen</b><br/>[Component: Flutter screen]<br/>Name, email and password form"]
    Profile["<b>ProfileScreen</b><br/>[Component: Flutter screen]<br/>Shows the profile, language selector, log out"]
    EditProfile["<b>EditProfileScreen</b><br/>[Component: Flutter screen]<br/>Form to change name, photo and phone"]

    AuthC["<b>AuthController</b><br/>[Component: Riverpod controller]<br/>Sign-in state, input checks, sign up, log in, log out"]
    ProfileC["<b>ProfileController</b><br/>[Component: Riverpod controller]<br/>Loads and saves the profile, loading and error states"]

    AuthR["<b>AuthRepository</b><br/>[Component: Repository]<br/>Wraps Firebase Auth: sign up, log in, log out, session"]
    UserR["<b>UserRepository</b><br/>[Component: Repository]<br/>Reads and writes the users collection"]
  end

  subgraph FIREBASE["Firebase (shared backend)"]
    direction LR
    FAuth["<b>Firebase Auth</b><br/>[External system]<br/>Accounts and sessions"]
    FStore["<b>Firestore</b><br/>[External system]<br/>users/{uid}<br/>users/{uid}/private/contact"]
  end

  Legend["<b>Legend</b><br/>Blue box: [Component: ...] part of the Flutter app<br/>Beige box: [External system] we do not build<br/>Arrow: who calls whom"]

  Login -->|"log in"| AuthC
  SignUp -->|"sign up"| AuthC
  Profile -->|"log out"| AuthC
  Profile -->|"load profile"| ProfileC
  EditProfile -->|"save profile"| ProfileC

  AuthC -->|"create profile after sign up"| UserR
  AuthC -->|"sign up, log in, log out"| AuthR
  ProfileC -->|"current user id"| AuthR
  ProfileC -->|"read and update profile"| UserR

  AuthR -->|"Firebase Auth SDK"| FAuth
  UserR -->|"Firestore SDK"| FStore

  AuthR ~~~ UserR
  FStore ~~~ Legend

  classDef component fill:#e8e8fb,stroke:#5b5bd6,stroke-width:1.5px,color:#1c1c4a;
  classDef external fill:#f1eee8,stroke:#8a8578,stroke-width:1.5px,color:#2a2a2a;
  classDef legend fill:#ffffff,stroke:#999999,stroke-width:1px,color:#333333;
  class Login,SignUp,Profile,EditProfile,AuthC,ProfileC,AuthR,UserR component;
  class FAuth,FStore external;
  class Legend legend;
  style APP fill:#ffffff,stroke:#5b5bd6,stroke-width:1.5px,stroke-dasharray:6 4;
  style FIREBASE fill:#ffffff,stroke:#8a8578,stroke-width:1.5px,stroke-dasharray:6 4;
