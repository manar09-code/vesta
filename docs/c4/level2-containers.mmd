%% C4 level 2: containers (VST-69). No Firebase Storage (photos are base64 in Firestore), no FCM in the MVP, OpenStreetMap instead of Google Maps.
flowchart TB
  Buyer["<b>Buyer / tenant / traveller</b><br/>Can browse as a guest"]:::person
  Owner["<b>Owner / agent</b>"]:::person
  subgraph APPS["Vesta mobile app (two versions)"]
    direction LR
    Flutter["<b>Flutter app</b><br/>[Dart, Android + iOS]"]:::ours
    RN["<b>React Native app</b><br/>[TypeScript, Android + iOS]"]:::ours
  end
  subgraph FB["Firebase (shared backend)"]
    direction LR
    Auth["<b>Firebase Auth</b><br/>[Accounts and sessions]"]:::ext
    Store["<b>Firestore</b><br/>[Listings, photos as base64, favorites, messages]"]:::ext
  end
  OSM["<b>OpenStreetMap</b><br/>[Map tiles]"]:::ext
  Buyer -->|"Searches, saves, contacts"| APPS
  Owner -->|"Publishes listings"| APPS
  APPS -->|"Signs users in"| Auth
  APPS -->|"Reads and writes data"| Store
  APPS -->|"Loads map tiles"| OSM
  style APPS fill:#f7f7ff,stroke:#6a64d8,stroke-dasharray:5 4
  style FB fill:#faf8f5,stroke:#8a8178,stroke-dasharray:5 4
  classDef person fill:#e3f4ec,stroke:#2a9d6f,color:#14543b
  classDef ours fill:#e8e8ff,stroke:#6a64d8,color:#2b2780
  classDef ext fill:#f1ede8,stroke:#8a8178,color:#3b3630
