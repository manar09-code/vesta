classDiagram
  class AppUser {
    +String uid
    +String displayName
    +DateTime createdAt
    +fromMap(Map map) AppUser
    +toMap() Map
  }
  class UserContact {
    +String email
    +String? phone
  }
  class Listing {
    +String id
    +String ownerId
    +String title
    +String description
    +num price
    +String currency
    +String? rentPeriod
    +String listingType
    +String propertyType
    +String city
    +double? latitude
    +double? longitude
    +int? bedrooms
    +int? bathrooms
    +num? areaSqm
    +int photoCount
    +DateTime createdAt
    +DateTime updatedAt
    +fromMap(Map map) Listing
    +toMap() Map
  }
  class Photo {
    +String id
    +String base64
    +DateTime createdAt
  }
  class Favorite {
    +String userId
    +String listingId
    +DateTime createdAt
  }
  class Conversation {
    +String id
    +List~String~ participantIds
    +String listingId
    +String lastMessage
    +DateTime lastMessageAt
  }
  class Message {
    +String id
    +String senderId
    +String text
    +DateTime createdAt
  }
  class UserRepository {
    +getUser(String uid) AppUser
    +saveUser(AppUser user)
  }
  class ListingRepository {
    +createListing(Listing listing)
    +getListings(filters) List~Listing~
  }
  class PhotoRepository {
    +addPhoto(String listingId, Photo photo)
    +getPhotos(String listingId) List~Photo~
  }
  class FavoritesRepository {
    +addFavorite(Favorite favorite)
    +removeFavorite(String userId, String listingId)
  }
  class ConversationRepository {
    +createConversation(Conversation conversation)
    +watchConversations(String uid)
  }
  class MessageRepository {
    +sendMessage(String conversationId, Message message)
    +watchMessages(String conversationId)
  }
  UserRepository ..> AppUser
  ListingRepository ..> Listing
  PhotoRepository ..> Photo
  FavoritesRepository ..> Favorite
  ConversationRepository ..> Conversation
  MessageRepository ..> Message
  AppUser "1" --> "1" UserContact : private
  AppUser "1" --> "*" Listing : owns
  Listing "1" --> "0..5" Photo : has
  AppUser "1" --> "*" Favorite : saves
  Conversation "1" --> "*" Message : contains